{
  "name": "example-cpm-tuning",
  "_comment": "示例配置：短剧 IAA 首日 ROI 顶价压价。照此结构改成你自己的业务。",
  "fetch": {
    "template": "olap_query_template.json",
    "referer": "https://app.example.corp/",
    "window_minutes": 15,
    "lag_minutes": 5,
    "aggregation": "weighted_mean",
    "columns": {
      "key": "账户ID",
      "time": "__time",
      "weight": "联盟总消耗",
      "metric": "IAA广告变现ROI"
    }
  },
  "enrich": {
    "id_field": "adCluster.accountId",
    "value_field": "bonusRate",
    "status": 4,
    "industry_version": "6.6",
    "multi_hit_policy": "latest",
    "default_value": 0.6
  },
  "evaluate": {
    "decimals": 2,
    "numeric_key_only": true,
    "cooldown_minutes": 0,
    "guardrail": {
      "min": 0.3,
      "max": 1.0
    },
    "bands": [
      {
        "max": 0.75,
        "delta": -0.1
      },
      {
        "min": 0.75,
        "max": 0.8,
        "delta": -0.02
      },
      {
        "min": 0.8,
        "max": 0.84,
        "delta": -0.01
      },
      {
        "min": 0.84,
        "max": 0.85,
        "delta": 0
      },
      {
        "min": 0.85,
        "max": 1.0,
        "delta": 0.01
      },
      {
        "min": 1.0,
        "max": 1.2,
        "delta": 0.02
      },
      {
        "min": 1.2,
        "delta": 0.03
      }
    ]
  },
  "write": {
    "name_max_length": 32,
    "end_time": "end_of_day",
    "background": "自动调价",
    "fields": {
      "name": "name",
      "background": "background",
      "value": "bonusRate",
      "id_list": "accountIds",
      "begin_time": "beginTime",
      "end_time": "endTime"
    }
  }
}